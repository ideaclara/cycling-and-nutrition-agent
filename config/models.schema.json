{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project model configuration",
  "type": "object",
  "required": ["region", "roles"],
  "additionalProperties": true,
  "properties": {
    "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-\\d$" },
    "roles": {
      "type": "object",
      "required": ["agent", "flow", "compare", "judge", "embeddings"],
      "additionalProperties": false,
      "properties": {
        "agent": { "$ref": "#/$defs/model" },
        "flow": { "$ref": "#/$defs/model" },
        "judge": { "$ref": "#/$defs/model" },
        "compare": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } },
        "embeddings": {
          "allOf": [{ "$ref": "#/$defs/model" }],
          "required": ["dimensions"],
          "properties": { "dimensions": { "enum": [256, 512, 1024] } }
        }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["modelId"],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer" }
      }
    }
  }
}
