# ==========================================
# Custom Exclusions
# ==========================================

# Exclude all files and subfolders inside the useful-source-files folder
useful-source-files/

# ==========================================
# Standard System and Log Files
# ==========================================

# Log files
*.log

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db

# Runtime / temporary files
*.tmp
*.bak

# ==========================================
# Build & dependency output
# ==========================================
node_modules/
cdk.out/
dist/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
coverage/

# Local environment / secrets
.env
.env.*
!.env.example

# Copyrighted knowledge-base source documents (kept local + in private S3 only)
bedrock/kb-docs/**/*.pdf
bedrock/kb-docs/**/*.epub

# Local reference output (e.g. `aws bedrock list-inference-profiles`)
documentation/inference-profiles-us-east-1.txt

# Raw Strava API responses contain personal GPS/location data and the repo is
# public. Keep them local; tests use services/tests/fixtures/activity_redacted.json.
documentation/initial-setup-documentation/strava-example-responses/*.json
